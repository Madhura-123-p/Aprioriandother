toy = [
    {"milk", "bread", "eggs"},
    {"milk", "bread"},
    {"bread", "butter"},
    {"milk", "bread", "butter"},
    {"bread", "eggs"},
]
a = apriori_custom(toy, min_support=0.4)
t = aprioritid_custom(toy, min_support=0.4)
assert a.keys() == t.keys(), "Frequent itemset keys differ"
assert all(abs(a[k] - t[k]) < 1e-12 for k in a), "Support values differ"
print("PASS: Apriori and AprioriTid return identical frequent itemsets on toy data.")
print(pd.DataFrame([{"itemset": sorted(list(k)), "support": v}
                    for k, v in sorted(a.items(), key=lambda kv: (len(kv[0]), sorted(kv[0])))]))